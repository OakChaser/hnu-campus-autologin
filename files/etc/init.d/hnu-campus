#!/bin/sh /etc/rc.common

USE_PROCD=1
START=95
STOP=10

start_service() {
    procd_open_instance
    procd_set_param command /usr/sbin/hnu-campus watch
    procd_set_param respawn 3600 5 0
    procd_set_param nice 10
    procd_set_param stdout 1
    procd_set_param stderr 1
    [ -f /etc/hnu-campus.conf ] && procd_set_param file /etc/hnu-campus.conf 2>/dev/null || true
    procd_close_instance
}

reload_service() {
    stop
    start
}
